+// --- Notes (Obsidian-inspired: markdown notes + [[wiki-link]] graph + tags) ---
+
+export interface Note {
+  id: number;
+  title: string;
+  body: string;
+  folder: string;
+  uid: string;
+  created_at: number;
+  updated_at: number;
+}
+
+export interface NoteBacklink {
+  id: number;
+  title: string;
+  folder: string;
+  uid: string;
+}
+
+export interface NoteTagCount {
+  tag: string;
+  count: number;
+}
+
+// Stable link target: lowercase slug from the title. Case-insensitive
+// resolution: [[My Note]] and [[my note]] both slug to "my-note".
+function slugifyUid(title: string): string {
+  return String(title == null ? '' : title)
+    .trim()
+    .toLowerCase()
+    .replace(/[^\w\s-]/g, '')
+    .replace(/[\s_]+/g, '-')
+    .replace(/-+/g, '-')
+    .replace(/^-|-$/g, '') || 'untitled';
+}
+
+// Disambiguate on collision so uid stays UNIQUE. The base slug still resolves
+// to the first note with that uid; later collisions get "-2", "-3", ...
+function uniqueUid(base: string, excludeId?: number): string {
+  let uid = base;
+  let n = 2;
+  const stmt = db.prepare('SELECT 1 FROM notes WHERE uid = ? AND id != ?');
+  while (stmt.get(uid, excludeId ?? -1)) {
+    uid = `${base}-${n++}`;
+  }
+  return uid;
+}
+
+// Parse [[Target]], [[Target#heading]], [[Target|alias]] → outbound links.
+function parseNoteLinks(body: string): { dst_uid: string; label: string | null; ord: number }[] {
+  const out: { dst_uid: string; label: string | null; ord: number }[] = [];
+  const re = /\[\[([^\]|#\[]+)(?:#[^\]|]+)?(?:\|([^\]]+))?\]\]/g;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(body)) !== null) {
+    const target = (m[1] || '').trim();
+    if (!target) continue;
+    out.push({ dst_uid: slugifyUid(target), label: m[2] ? m[2].trim() : null, ord: out.length });
+  }
+  return out;
+}
+
+// Parse #inline-tags plus a leading YAML `tags: [a, b]` frontmatter list.
+function parseNoteTags(body: string): string[] {
+  const tags = new Set<string>();
+  const fm = body.match(/^---\r?\n([\s\S]*?)\r?\n---/);
+  if (fm) {
+    const tagsLine = fm[1].match(/^tags:\s*\[(.*)\]/m);
+    if (tagsLine) {
+      tagsLine[1]
+        .split(',')
+        .map((s) => s.trim().replace(/^['"]|['"]$/g, ''))
+        .filter(Boolean)
+        .forEach((t) => tags.add(t));
+    }
+  }
+  const re = /(?:^|\s)#([A-Za-z][\w-]*)/g;
+  let m: RegExpExecArray | null;
+  while ((m = re.exec(body)) !== null) tags.add(m[1]);
+  return [...tags];
+}
+
+// Rebuild the link + tag rows for one note inside a transaction.
+function reindexNote(noteId: number, body: string): void {
+  db.prepare('DELETE FROM note_links WHERE src_id = ?').run(noteId);
+  db.prepare('DELETE FROM note_tags WHERE note_id = ?').run(noteId);
+  const insLink = db.prepare('INSERT INTO note_links (src_id, dst_uid, label, ord) VALUES (?, ?, ?, ?)');
+  for (const l of parseNoteLinks(body)) insLink.run(noteId, l.dst_uid, l.label, l.ord);
+  const insTag = db.prepare('INSERT OR IGNORE INTO note_tags (note_id, tag) VALUES (?, ?)');
+  for (const t of parseNoteTags(body)) insTag.run(noteId, t);
+}
+
+export function listNotes(filter?: { folder?: string; tag?: string; q?: string }): Note[] {
+  const conditions: string[] = [];
+  const values: unknown[] = [];
+  if (filter?.folder !== undefined) {
+    conditions.push('folder = ?');
+    values.push(filter.folder);
+  }
+  if (filter?.tag) {
+    conditions.push('id IN (SELECT note_id FROM note_tags WHERE tag = ?)');
+    values.push(filter.tag);
+  }
+  if (filter?.q) {
+    conditions.push('(title LIKE ? OR body LIKE ?)');
+    values.push(`%${filter.q}%`, `%${filter.q}%`);
+  }
+  const where = conditions.length ? ' WHERE ' + conditions.join(' AND ') : '';
+  return db.prepare(`SELECT * FROM notes${where} ORDER BY updated_at DESC`).all(...values) as Note[];
+}
+
+export function getNote(id: number): Note | undefined {
+  return db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;
+}
+
+export function getNoteByUid(uid: string): Note | undefined {
+  return db.prepare('SELECT * FROM notes WHERE uid = ?').get(uid) as Note | undefined;
+}
+
+export function createNote(input: { title: string; body?: string; folder?: string }): Note {
+  const title = (input.title || '').trim() || 'Untitled';
+  const uid = uniqueUid(slugifyUid(title));
+  const now = Date.now();
+  const body = input.body ?? '';
+  const folder = input.folder ?? '';
+  const tx = db.transaction(() => {
+    const info = db
+      .prepare('INSERT INTO notes (title, body, folder, uid, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)')
+      .run(title, body, folder, uid, now, now);
+    reindexNote(Number(info.lastInsertRowid), body);
+    return info;
+  });
+  const info = tx();
+  return getNote(Number(info.lastInsertRowid))!;
+}
+
+export function updateNote(
+  id: number,
+  updates: { title?: string; body?: string; folder?: string },
+): Note | undefined {
+  const existing = getNote(id);
+  if (!existing) return undefined;
+  const title = updates.title !== undefined ? ((updates.title || '').trim() || 'Untitled') : existing.title;
+  const body = updates.body !== undefined ? updates.body : existing.body;
+  const folder = updates.folder !== undefined ? updates.folder : existing.folder;
+  // If the title changed in a way that changes the slug, move uid to the new
+  // base (disambiguated) so [[links]] to the new title resolve. Renames that
+  // don't change the slug keep the uid stable (links don't break).
+  const newBase = slugifyUid(title);
+  const uid = newBase !== slugifyUid(existing.title) ? uniqueUid(newBase, id) : existing.uid;
+  const now = Date.now();
+  const tx = db.transaction(() => {
+    db
+      .prepare('UPDATE notes SET title = ?, body = ?, folder = ?, uid = ?, updated_at = ? WHERE id = ?')
+      .run(title, body, folder, uid, now, id);
+    reindexNote(id, body);
+  });
+  tx();
+  return getNote(id);
+}
+
+export function deleteNote(id: number): boolean {
+  // note_links / note_tags cascade via FK ON DELETE CASCADE.
+  return db.prepare('DELETE FROM notes WHERE id = ?').run(id).changes > 0;
+}
+
+export function moveNote(id: number, folder: string): Note | undefined {
+  const existing = getNote(id);
+  if (!existing) return undefined;
+  const now = Date.now();
+  db.prepare('UPDATE notes SET folder = ?, updated_at = ? WHERE id = ?').run(folder || '', now, id);
+  return getNote(id);
+}
+
+export function getBacklinks(uid: string): NoteBacklink[] {
+  return db
+    .prepare(
+      `SELECT n.id, n.title, n.folder, n.uid
+       FROM note_links l JOIN notes n ON n.id = l.src_id
+       WHERE l.dst_uid = ? ORDER BY n.updated_at DESC`,
+    )
+    .all(uid) as NoteBacklink[];
+}
+
+export function listNoteTags(): NoteTagCount[] {
+  return db
+    .prepare('SELECT tag, COUNT(*) AS count FROM note_tags GROUP BY tag ORDER BY count DESC, tag ASC')
+    .all() as NoteTagCount[];
+}
